# ==============================================================================
# BlueCode OS PayU Payment Module - Environment Configuration Template
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Server Network Configuration (Render sets PORT automatically)
PORT=5001
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas or self-hosted)
# Format: mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/bluecodeos_payments?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/bluecodeos_payments

# PayU India Merchant Credentials (Test Sandbox default credentials)
# Obtain these from your PayU Merchant Dashboard (Test or Production)
PAYU_MERCHANT_KEY=0pu2TB
PAYU_MERCHANT_SALT=hsSPhuQHRnuEIK3CmS7hMcXFrHiyRyYd

# PayU Gateway Endpoints
# Test Sandbox:
#   PAYU_PAYMENT_URL=https://test.payu.in/_payment
#   PAYU_POST_SERVICE_URL=https://test.payu.in/merchant/postservice?form=2
# Production Live:
#   PAYU_PAYMENT_URL=https://secure.payu.in/_payment
#   PAYU_POST_SERVICE_URL=https://info.payu.in/merchant/postservice?form=2
PAYU_PAYMENT_URL=https://test.payu.in/_payment
PAYU_POST_SERVICE_URL=https://test.payu.in/merchant/postservice?form=2

# Admin Secret Key for Protecting Refund & Audit Endpoints
# Generate a strong 32+ character random string
ADMIN_SECRET_KEY=bluecode_admin_secret_key_2026

# Frontend Client URL (Used for CORS and Callback Redirects)
# Can be a single URL or comma-separated list of allowed origins
CLIENT_URL=http://localhost:5173,http://localhost:5174

# Public Backend URL (Used to construct PayU surl and furl webhook callbacks)
SERVER_URL=http://localhost:5001
